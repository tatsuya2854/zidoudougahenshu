# ─────────────────────────────────────────────────────────────
#  Creator DNA Editor  環境変数
#  このファイルを .env にコピーして値を入れる。.env は git 管理外。
#  APIキーはバックエンドだけが読む。フロントには一切渡さない。
# ─────────────────────────────────────────────────────────────

# --- LLM（Shorts候補選定・Creator DNA解析） ---
# anthropic | openai | mock
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
OPENAI_API_KEY=

# --- 文字起こし ---
# auto | openai | faster_whisper | mock
# auto: OPENAI_API_KEY があれば openai、無ければ faster_whisper（ローカル・無料）、それも無ければ mock
TRANSCRIPTION_PROVIDER=auto
# openai: gpt-4o-transcribe-diarize / gpt-4o-transcribe / whisper-1
TRANSCRIPTION_MODEL=whisper-1
# faster_whisper 用（ローカル）: large-v3-turbo（既定・推奨） / large-v3 / medium / small / base / tiny
# 初回はモデルを HuggingFace から自動ダウンロード（large-v3-turbo は約 1.6GB）
FASTER_WHISPER_MODEL=large-v3-turbo
# auto | cpu | cuda（cpu は int8、cuda は float16）
FASTER_WHISPER_DEVICE=auto

# --- 映像解析（顔検出） ---
# yunet | none
VISION_PROVIDER=yunet

# --- 保存先・サーバ ---
DATA_DIR=../data
HOST=127.0.0.1
PORT=8765
# 起動時にブラウザを自動で開く
OPEN_BROWSER=true

# --- 字幕フォント（ffmpeg/libass が使うフォント名） ---
CAPTION_FONT=Noto Sans CJK JP
